{
  "schema": "tos.service.provider-quote-profile.v2",
  "provider_agent_id": "agent_<64 lowercase hex>",
  "manifest_cbor_file": "/absolute/private/provider/manifest.cbor",
  "transport": {
    "security_mode": 1,
    "max_request_bytes": 1048576,
    "base_url": "https://provider.example"
  },
  "proposal_ttl_seconds": 900,
  "tos_rpc_endpoints": [
    "https://rpc-1.example",
    "https://rpc-2.example",
    "https://rpc-3.example"
  ],
  "registry_code_boc_file": "/absolute/private/provider/native-registry.boc.base64",
  "service_actor_code_hash": "tvm-cell-sha256:<64 lowercase hex of the pinned Service Actor release>",
  "state_directory": "/absolute/private/provider/quote-state"
}
